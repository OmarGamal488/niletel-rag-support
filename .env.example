# LLM — Lightning AI hosts DeepSeek V4 Pro over an OpenAI-compatible endpoint.
LLM_PROVIDER=lightning
LIGHTNING_API_KEY=
LIGHTNING_BASE_URL=https://lightning.ai/api/v1/
LIGHTNING_MODEL=lightning-ai/deepseek-v4-pro

# LangSmith tracing (optional — LangChain Inc. SaaS)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=niletel-rag-support

# Langfuse — OSS LLM observability (cloud.langfuse.com or self-hosted)
# When keys are populated, every LangGraph invocation is traced.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com   # or https://us.cloud.langfuse.com, or your self-host URL

# Prometheus — exposes /metrics on the FastAPI app for Grafana scraping
PROMETHEUS_ENABLED=true

# n8n webhook for ticket creation
N8N_WEBHOOK_URL=

# Paths
DATA_DIR=./data/raw
CHROMA_DIR=./data/chroma_db
BM25_PATH=./data/bm25_index.pkl

# Retrieval — bge-m3 is multilingual (incl. Arabic), 1024-dim, 8k ctx.
# Re-run `uv run python -m src.ingestion` after changing this.
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4

# Retrieval mode:
#   hybrid     — dense + BM25 + RRF (baseline)
#   hyde       — LLM-hypothetical doc for the dense leg (Gao 2022)
#   rag_fusion — LLM generates N paraphrases; each runs hybrid retrieval;
#                all result lists RRF-fused (Rackauckas 2024, arXiv:2402.03367)
RETRIEVAL_MODE=hybrid
# Used by rag_fusion mode (original + n-1 paraphrases)
RAG_FUSION_NUM_QUERIES=4

# Two-stage retrieval: wider pool → cross-encoder rerank → top_k
RETRIEVER_TOP_N=20
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Reorder top-k so strongest chunks sit at context-window ends
# ("Lost in the Middle" mitigation, Liu et al. 2023)
LONG_CONTEXT_REORDER=true

# ---- Tier 2 — toggleable hallucination / quality features ----
# ALCE-style inline citations [N] in answers (Gao et al. 2023)
CITATIONS_ENABLED=true
# Chain-of-Verification — verify-then-revise pass (Dhuliawala et al. 2023)
CHAIN_OF_VERIFICATION=false
# Corrective RAG — assess retrieved docs; on 'incorrect', use web search
# (Yan et al. 2024). Requires TAVILY_API_KEY for the web fallback.
CRAG_ENABLED=false
TAVILY_API_KEY=
# Contextual Retrieval — pre-prepend LLM-generated context to each chunk
# before embedding (Anthropic, Sep 2024). Re-run ingestion after toggling.
CONTEXTUAL_RETRIEVAL=false

# ---- Tier 3 — production-readiness layer ----
# Regex-based PII redactor (Presidio-style). Strips Egyptian phone numbers,
# national IDs, emails, IBANs from queries before the LLM call. The tool
# agent still sees the original PII (it needs the real number to query CRM).
PII_REDACTION_ENABLED=true

# Semantic cache (GPTCache-style). Vector-similarity LRU keyed on the
# query embedding. COMPLAINT and ACTION queries are never cached.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=256

# Tool-calling ReAct agent — adds an ACTION route that calls SQLite-backed
# CRM tools (get_balance, list_open_tickets, escalate_to_human). The DB
# auto-seeds with 5 demo customers on first use.
TOOL_AGENT_ENABLED=true
CRM_DB_PATH=./data/fake_crm.sqlite

# TruLens-style RAG Triad evaluation. Run `uv run python -m src.triad_eval`
# to produce eval/triad_report.json alongside RAGAS.
TRIAD_EVAL_ENABLED=true
